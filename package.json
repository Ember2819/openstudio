{
  "name": "openstudio",
  "version": "0.2.0",
  "description": "OpenStudio — an open-source, pattern-based digital audio workstation (Electron + Web Audio)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/ensure.mjs",
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:mcp": "node scripts/e2e-mcp.mjs",
    "mcp": "node scripts/mcp-stdio.mjs --launch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "license": "MIT",
  "private": true,
  "author": "Olen Thompson and OpenStudio contributors",
  "keywords": [
    "daw",
    "music",
    "audio",
    "web-audio",
    "electron",
    "sequencer",
    "soundfont"
  ],
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ember2819/openstudio.git"
  },
  "bugs": {
    "url": "https://github.com/Ember2819/openstudio/issues"
  },
  "homepage": "https://github.com/Ember2819/openstudio#readme"
}
